# --- Datenquellen ---------------------------------------------------------
# OpenPLZ API: PLZ -> Orte + Straßenverzeichnis (amtlich, kostenlos)
OPENPLZ_BASE_URL=https://openplzapi.org

# Photon: fehlertolerantes Ranking (search-as-you-type).
# Öffentliche Instanz nur für Tests - für Telefonie-Last selbst hosten
# (docker compose --profile photon up). PHOTON_ENABLED=false schaltet ab.
PHOTON_BASE_URL=https://photon.komoot.io
PHOTON_ENABLED=true

# Einzugsgebiet: begrenzt die Photon-Suche und speist generate_keyterms.
# Kommagetrennte Postleitzahlen. Leer = bundesweit.
SERVICE_AREA_POSTAL_CODES=10115,10117,10119

# Bias-Punkt fürs Photon-Ranking (Mittelpunkt des Einzugsgebiets)
SERVICE_AREA_LAT=52.53
SERVICE_AREA_LON=13.38

# --- Schwellwerte ---------------------------------------------------------
# >= AUTO: übernehmen (mit Rückbestätigung)
# >= AMBIGUOUS: Auswahl vorlesen
# darunter: needsHuman = true -> Übergabe an einen Menschen
# Startwerte. Vor dem Rollout gegen echte Call-Logs nachjustieren -
# ohne Messung sind das geschätzte Zahlen, keine belegten.
CONFIDENCE_AUTO=0.85
CONFIDENCE_AMBIGUOUS=0.70
# Mindestabstand zum Zweitplatzierten für eine automatische Übernahme
MINIMUM_MARGIN=0.08
# Nur Kandidaten innerhalb dieses Abstands zum Besten werden vorgelesen
SUGGESTION_BAND=0.08

# --- Betrieb --------------------------------------------------------------
CACHE_TTL_SECONDS=86400
REQUEST_TIMEOUT_MS=4000
HTTP_PORT=8080
# Demo-Oberfläche und REST-API ausliefern (false = nur /mcp und /health)
WEB_ENABLED=true
# Optional: Bearer-Token für HTTP. Leer = offen. /health bleibt immer offen.
MCP_AUTH_TOKEN=
